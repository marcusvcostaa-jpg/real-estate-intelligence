# Copie para .env e preencha. Nunca commite o .env.

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=rei
POSTGRES_USER=rei
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rei:change-me@db:5432/rei
# Separate database used by pytest (created automatically on first `docker compose up`)
TEST_DATABASE_URL=postgresql+psycopg://rei:change-me@db:5432/rei_test

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- API ---
JWT_SECRET=generate-with-python-secrets-token-urlsafe-64
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT=100/minute
LOGIN_RATE_LIMIT=5/minute

# --- Coleta ---
# User-Agent enviado às fontes. Acrescente um contato (URL/e-mail) só se você decidir expô-lo:
# ex.: RealEstateIntelligenceBot/0.1 (+mailto:voce@exemplo.com)
SCRAPER_USER_AGENT=RealEstateIntelligenceBot/0.1

# --- Geografia ---
# Nominatim público: máx. 1 req/s, sem uso em massa (self-host para volume)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- LLM (desativado por padrão; serviço pago exige aprovação) ---
# none | ollama | anthropic
LLM_PROVIDER=none
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=

# --- Frontend ---
# The browser never calls the API directly; Next.js server code does (docker-compose sets
# API_INTERNAL_URL=http://api:8000/api/v1). Default for `npm run dev` on the host:
# API_INTERNAL_URL=http://localhost:8000/api/v1

# --- Backup ---
BACKUP_RETENTION_DAYS=14
